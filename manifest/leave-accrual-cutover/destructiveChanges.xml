<?xml version="1.0" encoding="UTF-8"?>
<!--
  LEAVE-51 — drops the two LEGACY formula fields, once nothing depends on them.

  This is the optional last step, not part of the deploy. The stored figures live in
  Accrued_To_Date__c and Available_Balance__c; these two are the old formulas, kept as a
  readable fallback and relabelled "(legacy formula)".

  Safe to run only when no report, saved list view or dashboard still selects them. No
  Apex does - that was the point of moving to new API names - so the delete that the
  platform refused before will now go through. Available_Days__c is listed first because
  its formula references Accrued_Days__c.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>Leave_Balance__c.Available_Days__c</members>
        <members>Leave_Balance__c.Accrued_Days__c</members>
        <name>CustomField</name>
    </types>
    <version>62.0</version>
</Package>
