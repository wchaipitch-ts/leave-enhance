<aura:component implements="forceCommunity:searchInterface">
  <aura:handler name='render' value='{!this}' action='{!c.afterRender}' />

  <aura:attribute name="language" type="String" default="{!$Locale.langLocale}"/>
  <aura:handler name="change" value="{!v.language}" action="{!c.handleLanguageSelect}"/>
  <lightning:select aura:id="selLanguage" name="select" label="" value="{!v.language}">
      <option value="en-US">English (US)</option>
      <option value="ja">日本語</option>
      <option value="th">ภาษาไทย</option>
  </lightning:select>
</aura:component>