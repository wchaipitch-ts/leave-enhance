<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Assign to the Managing Director. Grants Approve Leave Without Pay, checked by the Leave_Request_LWOP_Approval_Permission validation rule before LWOP Status may move to Approved or Rejected. Field access is included alongside it.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Leave Without Pay Approver</label>
    <customPermissions>
        <enabled>true</enabled>
        <name>Approve_Leave_Without_Pay</name>
    </customPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ApplicationItem__c.LWOP_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ApplicationItem__c.LWOP_Days__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ApplicationItem__c.LWOP_Approved_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ApplicationItem__c.LWOP_Approved_On__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ApplicationItem__c.LWOP_Approved_Days__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ApplicationItem__c.Paid_Days__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
