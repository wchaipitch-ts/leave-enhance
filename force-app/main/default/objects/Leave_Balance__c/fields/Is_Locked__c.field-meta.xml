<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Locked__c</fullName>
    <description>True while the employee is in probation and this type is probation-locked.</description>
    <formula>AND( Locked_During_Probation__c, NOT(ISBLANK(Employee__r.Probation_End_Date__c)), Employee__r.Probation_End_Date__c &gt;= TODAY() )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Locked</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
