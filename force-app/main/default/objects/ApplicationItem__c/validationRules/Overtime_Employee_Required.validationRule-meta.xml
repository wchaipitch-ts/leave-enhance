<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Overtime_Employee_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
          RecordType.DeveloperName = &quot;Overtime_Request&quot;,
          ISBLANK(Employee__c)
        )</errorConditionFormula>
    <errorDisplayField>Employee__c</errorDisplayField>
    <errorMessage>Choose the Employee these overtime hours were worked by. The request is recorded against them, not against you.</errorMessage>
</ValidationRule>
