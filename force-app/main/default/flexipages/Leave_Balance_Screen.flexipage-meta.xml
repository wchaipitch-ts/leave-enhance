<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Hosts the employee-facing Leave Balance screen, plus the temporary Leave Job Runner (LEAVE-49) above it. The runner renders for nobody without the Run Leave Job permission. Delete that item instance when the runner goes.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>leaveJobRunner</componentName>
                <identifier>leaveJobRunnerTemporary</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentName>leaveBalanceScreen</componentName>
                <identifier>leaveBalanceScreenComponent</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Leave Balance Screen</masterLabel>
    <template>
        <name>flexipage:defaultAppHomeTemplate</name>
    </template>
    <type>AppPage</type>
</FlexiPage>
